# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Ignore everything under rlm/weights by default
rlm/weights/**

# Allow only these two directories to be tracked by DVC
!rlm/weights/sft_lora/**
!rlm/weights/final_rlm_lora/**